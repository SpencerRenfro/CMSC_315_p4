<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>

<?import javafx.scene.layout.HBox?>
<!--<VBox alignment="CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml"-->
<!--      fx:controller="com.example.p4.HelloController">-->
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.p4.HelloController">
    <padding>
        <Insets top="20" right="40" bottom="20" left="40"/>
    </padding>

    <top>
        <HBox alignment="CENTER" spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button text="Add Edge"/>
            <Label text="Vertex 1"/>
            <TextField editable="false" prefWidth="100"/>
            <Label text="Vertex 2"/>
            <TextField editable="false" prefWidth="100"/>
        </HBox>
    </top>

    <center>
        <StackPane>
            <Pane fx:id="graphContainer" style="-fx-border-color: black; -fx-border-width: 1; -fx-background-color: white;"
                  maxWidth="Infinity" maxHeight="Infinity"
                  VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" />
        </StackPane>
    </center>

    <bottom>
        <VBox spacing="10">
            <HBox spacing="10" alignment="CENTER">
                <Button text="Is Connected?" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Has Cycles?" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Depth First Search" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Breadth First Search" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER">
                <TextField text="This is display-only" editable="false" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
<!--</VBox>-->
